# Copy this file to backend/.env and fill in the values. Never commit .env.

# PostgreSQL connection URL supplied by the team (External Database URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret used to sign session tokens (at least 32 characters). Generate one with:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=""

# Session lifetime in minutes.
JWT_EXPIRE_MINUTES=60

# "true" in production (HTTPS only); "false" for local development over HTTP.
SESSION_COOKIE_SECURE=false

